#!/usr/bin/env bash
# Local mirror of the server-side commit-lint + pr-hygiene gates: refuse to push commits whose
# message, or whose added diff lines, carry AI-attribution markers or internal issue-tracker keys.
# The public repo stays neutral and human-authored. Activate once after cloning:
#   git config core.hooksPath .githooks
# (The same rules are enforced server-side, so this is a convenience that catches issues earlier.)
set -uo pipefail

ai='co-authored-by:[[:space:]]*(claude|anthropic)|claude-session:|claude\.ai/code|generated (with|by) \[?claude|authored (with|by)[^.]*claude|anthropic\.com'
# This repo's own vault/tracker space code — see the OWN_PROJECT comment in
# .github/workflows/pr-hygiene.yml for why its ADR-<code>- prefix (and only that, not the
# bare <code>-<digits> issue-key form) is exempt from the block, and for why "IAM-002" being
# a substring of "ADR-IAM-002" means the two have to be classified per occurrence rather than
# scanned as two independent patterns over the whole text.
own_project='IAM'
# Internal tracker keys are matched by SHAPE, not by a list of project codes: a literal list
# would itself publish the private project codes this gate keeps out of public metadata, and
# would silently miss every project added after it was written.
#   - upper-case KEY-123 / KEY-S4 anywhere outside an http(s) URL
#   - lower-case key-123 only as a path segment (dir/key-123) or a key-123.md file name, so
#     case-insensitive coverage does not flag hyphenated prose such as "non-404" or "top-10"
#   - ADR-<code>-<n> for any <code> but this repo's own (see own_project above)
#   - any *.atlassian.net tenant host
# http(s) URLs (other projects' public trackers; file:// and app links stay scanned), version strings (surefire-3.5.6) and the public
# identifier schemes that share the KEY-123 shape (SHA-256, UTF-8, RFC-7636 …) pass.
public_schemes='ADR|AES|CVE|CWE|ECMA|FIPS|GHSA|HTTP|IEC|IEEE|ISO|JDK|JEP|JSR|NIST|OQ|OWASP|PKCE|PKCS|RFC|SHA|TLS|UTF'
b='(^|[^A-Za-z0-9_-])'
e='([^A-Za-z0-9_]|$)'   # a sprint id is S plus one or two digits, so PKCE-S256 is not one
tok_re="${b}ADR-[A-Z][A-Z0-9]+-[0-9]+|${b}[A-Z][A-Z0-9]+-(S[0-9]{1,2}|[0-9]+)(\.[0-9]+)*${e}|[A-Za-z_]/[a-z][a-z0-9]+-(s[0-9]{1,2}|[0-9]+)(\.[0-9]+)*${e}|${b}[a-z][a-z0-9]+-(s[0-9]{1,2}|[0-9]+)\.md"
has_internal_leak() {
  local tok key
  # Here-strings, not printf | grep -q: under pipefail an early-exiting grep can SIGPIPE the
  # writer and turn a match into a pass.
  grep -qiE '[a-z0-9-]+\.atlassian\.net' <<<"$1" && return 0
  while IFS= read -r tok; do
    tok=${tok%.md}
    [[ $tok =~ -[Ss]?[0-9]+\.[0-9] ]] && continue                  # version string
    key=$(printf '%s' "$tok" | sed -E 's#[^A-Za-z0-9]$##; s#^.*[^A-Za-z0-9-]##' | tr '[:lower:]' '[:upper:]')
    case "$key" in
      "") continue ;;
      "ADR-${own_project}-"*) continue ;;
      ADR-*-*) return 0 ;;
    esac
    [[ ${key%%-*} =~ ^($public_schemes)$ ]] && continue
    return 0
  done < <(sed -E 's#[Hh][Tt][Tt][Pp][Ss]?://[^[:space:]<>()"]*##g' <<<"$1" | grep -oE "$tok_re")
  return 1
}
zero='0000000000000000000000000000000000000000'
status=0

while read -r _localref localsha _remoteref remotesha; do
  [ "$localsha" = "$zero" ] && continue            # branch deletion — nothing to scan
  if [ "$remotesha" = "$zero" ]; then              # new branch — scan since main
    base=$(git merge-base origin/main "$localsha" 2>/dev/null || true)
    range=${base:+$base..}$localsha
  else
    range="$remotesha..$localsha"
  fi

  if grep -qiE "$ai" <<<"$(git log --format='%B' "$range" 2>/dev/null)"; then
    echo "pre-push BLOCKED: AI-attribution marker in a commit message ($range)." >&2
    status=1
  fi
  if has_internal_leak "$(git log --format='%B' "$range" 2>/dev/null)"; then
    echo "pre-push BLOCKED: internal tracker key or a foreign project's ADR-<code>- prefix in a commit message ($range)." >&2
    status=1
  fi

  added=$(git diff --unified=0 "$range" -- . \
            ':(exclude).github/workflows/pr-hygiene.yml' \
            ':(exclude).github/workflows/commit-lint.yml' \
            ':(exclude).githooks/pre-push' \
            ':(exclude)scripts/test-neutral-metadata.sh' \
          | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  if grep -qiE "$ai" <<<"$added"; then
    echo "pre-push BLOCKED: AI-attribution marker added in the diff ($range)." >&2
    status=1
  fi
  if has_internal_leak "$added"; then
    echo "pre-push BLOCKED: internal tracker key or a foreign project's ADR-<code>- prefix added in the diff ($range)." >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "  The public repo must stay neutral: no AI attribution, no internal issue-tracker keys." >&2
fi
exit "$status"
